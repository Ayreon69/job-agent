# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env / secrets
.env
.env.*
!.env.example

# Data / DB
# storage/jobs.db IS versioned (see .github/workflows/scrape-and-score.yml,
# session 8): a GitHub Actions run starts from a clean checkout each time, so
# the SQLite DB is committed back by the workflow itself to persist which
# offers are already known/scored across runs. Other *.db/*.sqlite3 files
# (local experiments, test DBs) stay ignored.
*.sqlite3
*.db
storage/*.db
!storage/jobs.db

# ChromaDB
chroma/
*.chroma/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
